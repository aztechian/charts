// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Charts",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"version": "1.33.7",
			"helm": "3.22.0",
			"minikube": "none"
		},
		"ghcr.io/devcontainer-community/devcontainer-features/jq:1": {},
		"ghcr.io/gickis/devcontainer-features/kubeconform:1": {},
		"ghcr.io/mpriscella/features/helm-chart-testing:1": {},
		"ghcr.io/dirsigler/devcontainer-features/helm-docs:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"redhat.vscode-yaml",
				"esbenp.prettier-vscode",
				"GitHub.vscode-pull-request-github",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"GitHub.vscode-github-actions",
				"vivswan.litellm-vscode-chat"
			]
		}
	},
	"mounts": [
		"source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached"
	]

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}